# Leave blank to use the existing Vercel /api rewrite or Vite development proxy.
# For a direct backend connection, use its HTTPS origin without /api.
VITE_API_BASE_URL=
# Optional public Key ID consistency check. Must match the backend Test Mode key.
# Standard Checkout receives the authoritative Key ID from the create-order API.
VITE_RAZORPAY_KEY_ID=
