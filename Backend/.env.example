NODE_ENV=development
# Optional local binding. Render always binds 0.0.0.0 using its supplied PORT.
# HOST=127.0.0.1
PORT=5000
# For MongoDB Atlas, use its mongodb+srv connection string here. URL-encode special characters in the password.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=eternal_india
FRONTEND_ORIGIN=http://localhost:5173
# Generate a long random value before starting the server.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional dedicated JWT signing secret (32+ characters); otherwise SESSION_SECRET is used.
AUTH_TOKEN_SECRET=
ADMIN_EMAIL=admin@eternal-india.local
# Used only to create the first administrator, or with npm run admin:password.
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Optional owner identity for Technical Panel permissions. Defaults to ADMIN_EMAIL.
# Other staff accounts require roles: ["technical"] in MongoDB.
TECHNICAL_EMAIL=
# Gmail delivery for account OTPs and password reset links.
# Enable Google 2-Step Verification and create an App Password. Never use your normal Gmail password.
COMPANY_NAME=Eternal India
# Render Free: use Brevo HTTPS instead of blocked SMTP ports (recommended).
# Set EMAIL_PROVIDER=brevo, BREVO_API_KEY, BREVO_SENDER_EMAIL and BREVO_SENDER_NAME in Render Environment.
# BREVO_SENDER_EMAIL must use a domain you own and have verified in Brevo, not @gmail.com.
# Alternatively use Resend: EMAIL_PROVIDER=resend, RESEND_API_KEY and EMAIL_FROM.
EMAIL_PROVIDER=auto
RESEND_API_KEY=
EMAIL_FROM=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Eternal India
# SMTP is retained for local development or hosting plans that permit it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Accepts a bare address or a display name, for example: Eternal India <sender@gmail.com>
SMTP_FROM=
# Optional dedicated random secret (32+ characters); otherwise SESSION_SECRET is used.
OTP_HASH_SECRET=
# A real Gmail inbox you own, used by npm run verify:gmail. This is never sent to the frontend.
OTP_TEST_EMAIL=

# Razorpay Standard Checkout: keep all secrets on the backend. Test Mode first.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Decimal rupees; the database and gateway use integer paise.
PAYMENT_MIN_AMOUNT_INR=1
PAYMENT_MAX_AMOUNT_INR=500000
# Optional alias for FRONTEND_ORIGIN; set to the actual Vercel origin on Render.
FRONTEND_URL=
