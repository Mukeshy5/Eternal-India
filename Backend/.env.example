NODE_ENV=development
HOST=127.0.0.1
PORT=5000
MONGO_URI=mongodb://localhost:27017
MONGO_DB=eternal_india
FRONTEND_ORIGIN=http://localhost:5173
# Generate a long random value before starting the server.
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@eternal-india.local
# Used only to create the first administrator, or with npm run admin:password.
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Optional owner identity for Technical Panel permissions. Defaults to ADMIN_EMAIL.
# Other staff accounts require roles: ["technical"] in MongoDB.
TECHNICAL_EMAIL=
# Gmail delivery for account OTPs and password reset links.
# Enable Google 2-Step Verification and create an App Password. Never use your normal Gmail password.
COMPANY_NAME=Eternal India
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional dedicated random secret (32+ characters); otherwise SESSION_SECRET is used.
OTP_HASH_SECRET=
# A real Gmail inbox you own, used by npm run verify:gmail. This is never sent to the frontend.
OTP_TEST_EMAIL=
